{
  "name": "@kromatv/react-native-tizen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React Native and Expo for Samsung Tizen TVs: Hermes and Fabric run natively, with no web runtime in between.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kromatv/react-native-tizen.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "tizen",
    "samsung",
    "smart-tv",
    "hermes"
  ],
  "bin": {
    "rn-tizen": "./src/cli/main.ts"
  },
  "files": [
    "src",
    "runtime",
    "shell",
    "simulator",
    "react-native-overrides",
    "docs",
    "README.md",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/api"
  },
  "dependencies": {
    "@formatjs/intl-numberformat": "10.0.2",
    "@formatjs/intl-pluralrules": "7.0.2",
    "@formatjs/intl-relativetimeformat": "13.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "exports": {
    "./metro": "./src/metro/with-tizen.ts",
    "./voice": "./src/api/voice.ts",
    "./preview": "./src/api/preview.ts",
    "./preview-json": "./src/api/preview-json.ts",
    "./package.json": "./package.json"
  },
  "author": "Maxime Scharwath <maxscharwath@gmail.com>"
}
